# Copy to .env.test and adjust. Bun auto-loads .env.test when NODE_ENV=test,
# but Playwright doesn't — dotenv is loaded manually in playwright.config.ts.

# --- Test database (must be separate from the dev DB) -----------------------
# On first run, global-setup connects to the "postgres" maintenance DB using
# the same credentials and creates this database if it doesn't exist yet.
TEST_DATABASE_URL="postgresql://postgres:dummy%40123@localhost:5433/helpdesk_test?schema=public"

# --- Ports used by Playwright-managed servers -------------------------------
# Chosen to not collide with dev (3000 / 5173), so `bun run test` works while
# dev servers are still running.
TEST_BACKEND_PORT=3001
TEST_FRONTEND_PORT=5174

# --- Backend env injected into the test backend process ---------------------
# 32-byte base64 — generate with: openssl rand -base64 32
TEST_BETTER_AUTH_SECRET="Y3AvJ73a5+FtSWrch/Kny2X5MebrZv6qS0PgP+iG53k="

# --- Seeded admin user ------------------------------------------------------
TEST_ADMIN_EMAIL="admin@test.com"
TEST_ADMIN_PASSWORD="password123"
