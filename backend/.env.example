# Adjust user/password/host/port to match your local Postgres.
# macOS Homebrew default: no password, user = OS username.
DATABASE_URL="postgresql://saifsheikh@localhost:5432/helpdesk?schema=public"
PORT=3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of origins allowed to call the auth API.
TRUSTED_ORIGINS="http://localhost:5173"

# Credentials for the initial admin user created by `bun run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
